{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jev-omok",
  "account_id": "<account-id>",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // The Next.js static export is served by the Assets binding. Only /api/* has
  // to reach the Worker first; everything else is a file or the SPA fallback.
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "vars": {
    "JEV_MODEL": "jev-latest",
    "JEV_BASE_URL": "https://api.typesafe.ai"
  },

  // TYPESAFE_API_KEY is a secret: `wrangler secret put TYPESAFE_API_KEY`.
  "routes": [{ "pattern": "omok.sharosoo.com", "custom_domain": true }]
}
